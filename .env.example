# Foundry runtime configuration. Copy to .env and adjust.
# Loaded by `pnpm dev` / `pnpm start` via node --env-file-if-exists.

# Port for HTTP + WS (one port serves both planes). Default 8787.
FOUNDRY_PORT=8787

# Bind address. 127.0.0.1 for local-only; set to your LAN/Tailscale interface
# for remote clients (never expose 8787 publicly in v0 — ADR-009).
FOUNDRY_HOST=127.0.0.1

# All persistent state (db, blobs, workspaces). Default ./data.
FOUNDRY_DATA_DIR=./data

# DB path. Default $FOUNDRY_DATA_DIR/foundry.db.
# FOUNDRY_DB_PATH=./data/foundry.db

# REQUIRED. Master secret for the AES-256-GCM key vault (ADR: vault).
# Generate one:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Rotating or losing this key makes all stored provider keys unrecoverable.
FOUNDRY_MASTER_KEY=

# Log level (fatal|error|warn|info|debug|trace). Default info.
FOUNDRY_LOG_LEVEL=info

# Sandbox env time-to-live in seconds (default 7200; terminal/env reclaim, §4).
# FOUNDRY_ENV_TTL=7200

# Integration tests requiring Docker are skipped unless this is set. P2+.
# FOUNDRY_INTEGRATION=1
# Approval gate auto-deny timeout in ms (P3). Default 900000 (15 min).
# FOUNDRY_GATE_TIMEOUT_MS=900000

# Scheduler tick interval in ms (P3). Default 30000.
# FOUNDRY_TICK_MS=30000

# ntfy push (P3): set both to enable run/gate/schedule notifications.
# FOUNDRY_NTFY_URL=https://ntfy.example
# FOUNDRY_NTFY_TOPIC=foundry

# Web SPA build dir override (P4). Default: apps/web/build in the repo.
# FOUNDRY_WEB_DIR=./apps/web/build

# Owner account for the user-facing login (ADR-014). Username defaults to
# "admin". Set a password here for the FIRST credential bootstrap; if unset,
# boot generates one and writes admin_credentials.txt under $FOUNDRY_DATA_DIR
# (the file is the only copy). Ignored once credentials exist.
# FOUNDRY_ADMIN_USER=admin
# FOUNDRY_ADMIN_PASSWORD=

# --- P5 hardening -------------------------------------------------------------

# Metering (ADR-016): per-user chat.send rate, per-identity completions rate,
# and the concurrent-run cap per user. Denials = capacity (WS) / 429 (REST).
# FOUNDRY_RATE_CHAT_PER_MIN=60
# FOUNDRY_RATE_API_PER_MIN=600
# FOUNDRY_MAX_CONCURRENT_RUNS=8

# Backup job (ADR-017): minutes between runs (0 = off; default daily). Each
# run writes <FOUNDRY_DATA_DIR>/backups/<ts>/ (sqlite snapshot + blob copy,
# keep 7) and a manual trigger is at POST /v1/admin/backup.
# FOUNDRY_BACKUP_MIN=1440

# Opt-in alternate OCI runtime for all sandbox containers this process
# launches (ADR-018) — e.g. gVisor: runsc (the daemon must have it installed;
# containers fail to start otherwise). Unset = daemon default (runc). The
# desktop runner takes --runtime the same way.
# FOUNDRY_SANDBOX_RUNTIME=runc
