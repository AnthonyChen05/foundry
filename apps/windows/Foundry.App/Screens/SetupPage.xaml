<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Foundry_App.Screens.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- First-run setup: where the user enters their backend server address (the v1.2
         shell parity, now native). The core answers /healthz on the SAME port as REST. -->
    <Grid Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel MaxWidth="440" Spacing="12">
            <FontIcon Glyph="&#xE74C;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            <TextBlock Text="Foundry" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="Hint" Text="Your self-hosted Foundry core. Enter the backend's address — same origin serves the web app and API." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="UrlBox" Header="Server address" PlaceholderText="http://127.0.0.1:8787" />
            <TextBlock x:Name="Status" MinHeight="20" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnect" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>