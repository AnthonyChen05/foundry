<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Foundry_App.Screens.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- Settings (Android-parity cards + the setup-screen re-entry): session, executor,
         models catalog, providers (admin REST), password, notifications (in-app+toasts). -->
    <ScrollViewer Padding="16,8,16,16">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="14">

            <!-- session -->
            <Expander Header="Session" IsExpanded="True">
                <StackPanel Spacing="10" Margin="4">
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">server</TextBlock>
                    <TextBlock x:Name="ServerLine" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="UserLine" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">connection</TextBlock>
                    <TextBlock x:Name="ConnLine" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reconnect" Click="OnReconnect" />
                        <Button Content="Change server…" Click="OnChangeServer" />
                        <Button x:Name="SignOutBtn" Content="Sign out" Click="OnSignOut" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- executor (ADR-015) -->
            <Expander Header="Local executor">
                <StackPanel Spacing="10" Margin="4">
                    <TextBlock x:Name="ExecLine" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExecDetail" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="RunnerBtn" Content="Configure local sandbox…" Click="OnConfigRunner" Visibility="Collapsed" />
                    <TextBlock x:Name="LocalNote" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!-- models -->
            <Expander Header="Models (catalog)">
                <StackPanel Spacing="6" Margin="4">
                    <TextBlock x:Name="ModelsEmpty" Text="catalog empty — configure providers server-side" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ItemsControl x:Name="ModelsList" />
                </StackPanel>
            </Expander>

            <!-- providers -->
            <Expander x:Name="ProvidersCard" Header="Providers">
                <StackPanel Spacing="10" Margin="4">
                    <StackPanel x:Name="ProviderRows" Spacing="6" />
                    <Button Content="Add provider…" Click="OnAddProvider" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <!-- password -->
            <Expander Header="Password">
                <StackPanel Spacing="10" Margin="4">
                    <PasswordBox x:Name="CurPass" Header="Current password" />
                    <PasswordBox x:Name="NewPass" Header="New password (8–128)" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="SavePassBtn" Content="Change password" Click="OnChangePassword" />
                        <TextBlock x:Name="PassStatus" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- notifications -->
            <Expander Header="Notifications">
                <StackPanel Spacing="8" Margin="4">
                    <TextBlock x:Name="NotifLine" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12">Recent pushes</TextBlock>
                    <ItemsControl x:Name="NotifList" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="Footer" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>