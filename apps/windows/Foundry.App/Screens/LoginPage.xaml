<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Foundry_App.Screens.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Sign-in: server address editable (prefilled from setup/session), owner credentials.
         Android login-screen parity incl. the first-boot hint. -->
    <Grid Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel MaxWidth="440" Spacing="12">
            <TextBlock Text="Foundry" FontSize="24" FontWeight="SemiBold" />
            <TextBox x:Name="ServerBox" Header="Server" PlaceholderText="http://127.0.0.1:8787" />
            <TextBox x:Name="UserBox" Header="Username" PlaceholderText="admin" />
            <PasswordBox x:Name="PassBox" Header="Password" />
            <TextBlock x:Name="Status" MinHeight="20" TextWrapping="Wrap" />
            <Button x:Name="GoBtn" Content="Sign in" Click="OnSignIn" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
                First-boot owner credentials are in the core's data dir (admin_credentials.txt).
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>