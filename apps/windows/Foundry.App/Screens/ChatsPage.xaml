<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Foundry_App.Screens.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Three-pane chat surface: list | messages | run inspector (the web client's
         right-panel pattern). The inspector = the active run: status, gates, timeline
         (replay + live merged). Collections rebuild from the snapshot (the page
         coalesces to ~one render per 60ms tick). -->
    <Page.Resources>
        <screen:LineSelector
            x:Key="LineSelector"
            xmlns:screen="using:Foundry_App.Screens"
            UserTemplate="{StaticResource UserBubble}"
            AssistantTemplate="{StaticResource AssistantBubble}"
            ToolTemplate="{StaticResource ToolRow}"
            ToolMetaTemplate="{StaticResource ToolMetaRow}"
            LiveTemplate="{StaticResource LiveDraft}"
            HintTemplate="{StaticResource HintRow}" />

        <DataTemplate x:Key="UserBubble">
            <Border MaxWidth="640" HorizontalAlignment="Right" Padding="14,9" CornerRadius="14,14,4,14"
                    Background="#D97757">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AssistantBubble">
            <Border MaxWidth="640" HorizontalAlignment="Left" Padding="14,9" CornerRadius="14,14,14,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ToolRow">
            <TextBlock MaxWidth="640" HorizontalAlignment="Left" FontFamily="Consolas" FontSize="11"
                       Text="{Binding Text}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>
        <DataTemplate x:Key="ToolMetaRow">
            <TextBlock FontFamily="Consolas" FontSize="12" HorizontalAlignment="Left" Text="{Binding Text}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>
        <DataTemplate x:Key="LiveDraft">
            <Border MaxWidth="640" HorizontalAlignment="Left" Padding="14,9" CornerRadius="14,14,14,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HintRow">
            <TextBlock HorizontalAlignment="Center" Text="{Binding Text}" Margin="0,40,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </DataTemplate>

        <!-- inspector (timeline) row templates -->
        <DataTemplate x:Key="RowBase">
            <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Text}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>
        <DataTemplate x:Key="RowErr">
            <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Text}" TextWrapping="Wrap"
                       Foreground="#DD6E63" />
        </DataTemplate>
        <DataTemplate x:Key="RowLive">
            <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Text}" TextWrapping="Wrap"
                       Foreground="#8DB087" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" x:Name="InspectorCol" />
        </Grid.ColumnDefinitions>

        <!-- list pane -->
        <Grid Grid.Column="0" Margin="8,0,4,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Content="New chat" Click="OnNewChat" HorizontalAlignment="Stretch" />
            <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnChatSelected"
                      ItemsSource="{x:Bind Vm.ChatRows}"
                      SelectedIndex="{x:Bind Vm.SelectedChatIndex, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="6,1" CornerRadius="9"
                                    Visibility="{Binding ShowLocation}">
                                <TextBlock Text="{Binding Location}" FontSize="11" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Meta}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- messages pane -->
        <Grid Grid.Column="1" Margin="8,0,8,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="LinesList" ItemsSource="{x:Bind Vm.Lines}" SelectionMode="None"
                      ItemTemplateSelector="{StaticResource LineSelector}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <!-- composer -->
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <TextBox
                        x:Name="Composer"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        PlaceholderText="Message (Enter to send, Shift+Enter for a newline)"
                        KeyDown="OnComposerKey" />
                </ScrollViewer>
                <Button Grid.Column="1" x:Name="SendBtn" Content="Send" Click="OnSend" VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind Vm.SendEnabled, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="8,6,8,0">
                <ComboBox x:Name="ModelBox" MinWidth="220" ItemsSource="{x:Bind Vm.Models}" SelectionChanged="OnModelChanged" />
                <ToggleSwitch x:Name="AgentSwitch" OnContent="agent" OffContent="plain" Toggled="OnAgentToggled" />
                <Button x:Name="PolicyBtn" Content="Tool policy" Click="OnPolicy">
                    <Button.Flyout>
                        <Flyout x:Name="PolicyFlyout">
                            <StackPanel Spacing="8" Margin="4,4,4,8">
                                <TextBlock Text="Agent tool policy" FontWeight="SemiBold" />
                                <TextBlock Text="What the agent does without asking. Session/Always persist this conversation." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="shell" FontSize="12" Margin="0,4,0,0" />
                                <ComboBox x:Name="PolicyShell" SelectedIndex="0" MinWidth="150">
                                    <ComboBoxItem Content="ask" />
                                    <ComboBoxItem Content="always" />
                                    <ComboBoxItem Content="always (session)" />
                                    <ComboBoxItem Content="deny" />
                                </ComboBox>
                                <TextBlock Text="write_file" FontSize="12" />
                                <ComboBox x:Name="PolicyWrite" SelectedIndex="0" MinWidth="150">
                                    <ComboBoxItem Content="ask" />
                                    <ComboBoxItem Content="always" />
                                    <ComboBoxItem Content="always (session)" />
                                    <ComboBoxItem Content="deny" />
                                </ComboBox>
                                <TextBlock Text="read_file" FontSize="12" />
                                <ComboBox x:Name="PolicyRead" SelectedIndex="1" MinWidth="150">
                                    <ComboBoxItem Content="ask" />
                                    <ComboBoxItem Content="always" />
                                    <ComboBoxItem Content="always (session)" />
                                    <ComboBoxItem Content="deny" />
                                </ComboBox>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="LocBtn" Content="Executes: cloud" Click="OnLocation"
                        IsEnabled="False"
                        Margin="0,0,0,0" />
                <Button x:Name="PushBtn" Content="Push to cloud" Click="OnPush" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- inspector pane (the active run) -->
        <Grid Grid.Column="2" Margin="4,0,8,8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RunTitle" Text="No run yet" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Click="OnCancel" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="RunStatus" Grid.Row="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <StackPanel x:Name="GatesPanel" Grid.Row="2" Spacing="6" />
            <ScrollViewer Grid.Row="3" Padding="0,4,0,0">
                <ItemsControl x:Name="TimelineList" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>