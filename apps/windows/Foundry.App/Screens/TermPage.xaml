<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Foundry_App.Screens.TermPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- PTY terminal: scrollback (SGR-colored runs) + raw keystroke input + term.resize on
         window-size changes. One live session per env (reopen rejoins the same termId). -->
    <Grid RowSpacing="8" SizeChanged="OnSizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TermStatus" Text="connecting…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TermEnv" Text="" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" Padding="10,8,10,8"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <RichTextBlock x:Name="BackBuffer" FontFamily="Cascadia Mono,Consolas" FontSize="13"
                           TextWrapping="Wrap" LineHeight="19" IsTextSelectionEnabled="True" />
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnSpacing="8" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LineBox" PlaceholderText="type a line for the shell (Enter sends); the scrollback above = output" KeyDown="OnLineKey" />
            <Button Grid.Column="1" Content="Send line" Click="OnSendLine" />
        </Grid>
    </Grid>
</Page>