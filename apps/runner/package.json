{
  "name": "@foundry/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foundry desktop executor runner (ADR-015): hosts the LOCAL sandbox and answers core's server→client executor requests",
  "exports": {
    ".": "./dist/main.js",
    "./exec-server": "./dist/execserver.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/protocol": "workspace:*",
    "@foundry/sdk-ts": "workspace:*",
    "dockerode": "^4.0.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/tar": "^7.0.87",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}