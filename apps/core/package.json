{
  "name": "@foundry/core",
  "version": "0.1.0",
  "description": "Foundry core: gateway, providers, agent runtime, sandbox, storage (the monolith)",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./config": "./dist/config.js",
    "./db": "./dist/db/open.js",
    "./vault": "./dist/vault/vault.js",
    "./runtime": "./dist/runtime.js",
    "./sandbox": "./dist/sandbox/index.js",
    "./executor": "./dist/executor/index.js"
  },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.0.0",
    "@foundry/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^12.0.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "sqlite-vec": "^0.1.6",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@foundry/sdk-ts": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/tar": "^7.0.87",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.0.0"
  }
}