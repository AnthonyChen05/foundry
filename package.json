{
  "name": "foundry",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted backend for LLM frontends: gateway + provider switchboard + agent runtime + sandbox",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @foundry/core dev",
    "start": "pnpm --filter @foundry/core start",
    "db:generate": "drizzle-kit generate",
    "presmoke": "pnpm -r build",
    "smoke": "tsx scripts/smoke.ts",
    "probe:ollama": "tsx scripts/ollama-probe.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@foundry/core": "workspace:*",
    "@foundry/runner": "workspace:*",
    "@foundry/sdk-ts": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sqlite-vec"
    ]
  }
}