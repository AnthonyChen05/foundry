{
  "name": "@foundry/protocol",
  "version": "0.0.0",
  "description": "Foundry wire protocol v0 — TypeBox schemas, frame types, JSON Schema export",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/json-schema.d.ts",
      "import": "./dist/json-schema.js"
    }
  },
  "files": [
    "dist",
    "schema/generated"
  ],
  "scripts": {
    "build": "tsx ./tools/emit-json-schema.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "emit": "tsx ./tools/emit-json-schema.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}