{
  "$id": "EventPayload.run.gate_resolved",
  "type": "object",
  "required": [
    "gateId",
    "approved",
    "scope",
    "state"
  ],
  "properties": {
    "gateId": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    },
    "scope": {
      "description": "Scope of an approval: this call, this session, or forever.",
      "anyOf": [
        {
          "const": "once",
          "type": "string"
        },
        {
          "const": "session",
          "type": "string"
        },
        {
          "const": "always",
          "type": "string"
        }
      ]
    },
    "state": {
      "description": "Gate lifecycle: open → approved|denied|timeout.",
      "anyOf": [
        {
          "const": "open",
          "type": "string"
        },
        {
          "const": "approved",
          "type": "string"
        },
        {
          "const": "denied",
          "type": "string"
        },
        {
          "const": "timeout",
          "type": "string"
        }
      ]
    }
  },
  "title": "EventPayload.run.gate_resolved"
}
